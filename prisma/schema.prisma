generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  tenant Tenant?
  role Role? 
  properties Property[] @relation("OwnedProperties")
}

enum UserRole {
  LANDLORD
  TENANT
}

model Role {
  id Int @id @default(autoincrement())
  role UserRole @default(TENANT)
  userId Int @unique
  user User @relation(fields: [userId], references: [id])
}

model Property {
  id Int @id @default(autoincrement())
  name String
  address String
  ownerId Int
  owner User @relation("OwnedProperties", fields: [ownerId], references: [id])
  leases Lease[]
  archivedAt DateTime?
}

model Tenant {
  id Int @id @default(autoincrement())
  name String
  phoneNumber String
  userId Int @unique
  user User @relation(fields: [userId], references: [id])
  leases Lease[]
  payments Payment[]
  archivedAt DateTime?
}

model Lease {
  id Int @id @default(autoincrement())
  propertyId Int
  rentalPrice BigInt
  property Property @relation(fields: [propertyId], references: [id])
  tenants Tenant[]
  startDate DateTime
  endDate DateTime
  payments Payment[]
  periods Period[]
  archivedAt DateTime?
}

enum PaymentStatus {
  PENDING
  REVIEW
  COMPLETED
  FAILED
}

model Period {
  id Int @id @default(autoincrement())
  leaseId Int
  lease Lease @relation(fields: [leaseId], references: [id])
  name String
  startDate DateTime
  endDate DateTime
  dueDate DateTime
  payments Payment[]
  archivedAt DateTime?
}

model Payment {
  id Int @id @default(autoincrement())
  leaseId Int
  amount BigInt
  paymentDate DateTime @default(now())
  lease Lease @relation(fields: [leaseId], references: [id])
  periodId Int
  period Period @relation(fields: [periodId], references: [id])
  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])
  status PaymentStatus @default(PENDING)

  @@unique([periodId, tenantId])
}
